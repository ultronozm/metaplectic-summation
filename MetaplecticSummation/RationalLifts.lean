import MetaplecticSummation.RationalOrbits

/-! Restricted lifts and the action of rational matrices in Lemma B.5. -/
noncomputable section
namespace MetaplecticPoisson
open NumberField IsDedekindDomain Filter
open scoped Matrix MatrixGroups
open Classical
variable {F : Type} [Field F]

namespace Datum
variable [NumberField F] {n : ℕ} [NeZero n] (d : Datum F n)

private theorem rational_upper_evaluation (t : F) (g : ∀ v, d.Operators v)
    (hg : ∀ v, d.IsUpper v (diagonal F v t) (g v))
    (f : ∀ v, d.schwartz v) (hf : ∀ᶠ v in cofinite, f v = d.basic v)
    (hgf : ∀ᶠ v in cofinite, g v (f v) = d.basic v)
    (z q : RationalPoint F) (hq : q.val = (z.val.1,z.val.2+t*z.val.1)) :
    d.evaluation (d.pure (fun v => g v (f v)) hgf) z = d.evaluation (d.pure f hf) q := by
  rw [d.evaluation_pure,d.evaluation_pure]
  apply finprod_congr
  intro v
  simp only [localValue,diagonalPoint,hq]
  by_cases hx : z.val.1 ≠ 0
  · have h := (map_ne_zero (diagonal F v)).mpr hx
    simp only [ite_eq_left hx,xChart,dite_eq_left h,map_add,map_mul]
    exact (hg v (f v)).1 _ _
  · have hzero := not_ne_iff.mp hx
    have hy : z.val.2 ≠ 0 := fun h => z.property (Prod.ext hzero h)
    have h := (map_ne_zero (diagonal F v)).mpr hy
    simp only [hzero,ne_eq,not_true_eq_false,ite_false,map_zero,mul_zero,add_zero,yChart,dite_eq_left h]
    exact (hg v (f v)).2 _

private theorem rational_lower_evaluation (t : F) (g : ∀ v, d.Operators v)
    (hg : ∀ v, d.IsLower v (diagonal F v t) (g v))
    (f : ∀ v, d.schwartz v) (hf : ∀ᶠ v in cofinite, f v = d.basic v)
    (hgf : ∀ᶠ v in cofinite, g v (f v) = d.basic v)
    (z q : RationalPoint F) (hq : q.val = (z.val.1+t*z.val.2,z.val.2)) :
    d.evaluation (d.pure (fun v => g v (f v)) hgf) z = d.evaluation (d.pure f hf) q := by
  by_cases hy : z.val.2 ≠ 0
  · rw [d.evaluation_pure_y _ _ _ hy,d.evaluation_pure_y _ _ _ (show q.val.2 ≠ 0 by simpa [hq] using hy)]
    apply finprod_congr
    intro v
    have Y (r : RationalPoint F) (hr : r.val.2 ≠ 0) (φ : d.schwartz v) :
        yChart φ.val (diagonalPoint r v) = φ.val.2 (diagonal F v r.val.1)
          (Units.mk0 (diagonal F v r.val.2) ((map_ne_zero _).2 hr)) := dite_eq_left ((map_ne_zero _).2 hr)
    rw [Y z hy,Y q (by simpa [hq] using hy)]
    simp only [hq,map_add,map_mul]
    exact (hg v (f v)).1 _ _
  · have hzero := not_ne_iff.mp hy
    have hx : z.val.1 ≠ 0 := fun h => z.property (Prod.ext h hzero)
    rw [d.evaluation_pure,d.evaluation_pure]
    apply finprod_congr
    intro v
    have h := (map_ne_zero (diagonal F v)).mpr hx
    simp only [localValue,diagonalPoint,hq,hzero,mul_zero,add_zero,ite_eq_left hx,xChart,dite_eq_left h,map_zero]
    exact (hg v (f v)).2 _

/-- Integral lifts are generated by the shears with integral parameter. -/
def integralCover (p : Prime F) : Subgroup (d.cover (.inr p)) :=
  Subgroup.closure {g | ∃ u, ‖u‖ ≤ 1 ∧ (d.IsUpper (.inr p) u g.val ∨ d.IsLower (.inr p) u g.val)}

theorem integralCover_fixes_basic (p : Prime F) (ht : p.asIdeal.absNorm.Coprime n)
    {g : d.cover (.inr p)} (hg : g ∈ d.integralCover p) :
    g.val (d.basic (.inr p)) = d.basic (.inr p) := by
  let v : Place F := .inr p
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨u,hu,h|h⟩ := hg
    · apply Subtype.ext
      have e := d.eq_upperShear v (d.schwartz_glues v (g.val (d.basic v))) u
        ((h (d.basic v)).1) ((h (d.basic v)).2)
      exact e.trans (by simpa only [v,basic,dite_eq_left ht] using (d.basicCharts_shear p ht u hu).1)
    · apply Subtype.ext
      have e := d.eq_lowerShear v (d.schwartz_glues v (g.val (d.basic v))) u
        ((h (d.basic v)).1) ((h (d.basic v)).2)
      exact e.trans (by simpa only [v,basic,dite_eq_left ht] using (d.basicCharts_shear p ht u hu).2)
  | one => rfl
  | mul x y _ _ hx hy => exact (congrArg x.val hy).trans hx
  | inv x _ hx => exact x.val.injective ((x.val.apply_symm_apply _).trans hx.symm)

/-- Projection from the local Kubota cover to the matrix group. -/
def coverProjection (v : Place F) := (d.kubota_projection v).choose

def IsRestrictedCover (g : ∀ v, d.cover v) : Prop :=
  ∀ᶠ p : Prime F in cofinite, g (.inr p) ∈ d.integralCover p

theorem restrictedCover_fixes_basic {g : ∀ v, d.cover v} (hg : d.IsRestrictedCover g) :
    ∀ᶠ v in cofinite, (g v).val (d.basic v) = d.basic v := by
  apply eventually_place_of_finite
  filter_upwards [eventually_tame (F := F) (n := n),hg] with p ht hp
  exact d.integralCover_fixes_basic p ht hp

/-- The upper unipotent attached to an adele, as a family of local lifts. -/
def upperLift (u : Adeles F) (v : Place F) : d.cover v :=
  let s := (d.exists_upper v (component u v)).exists
  ⟨s.choose,Subgroup.subset_closure (Or.inr (Or.inl ⟨_,s.choose_spec⟩))⟩

theorem upperLift_isUpper (u : Adeles F) (v : Place F) :
    d.IsUpper v (component u v) (d.upperLift u v).val :=
  (d.exists_upper v (component u v)).exists.choose_spec

theorem upperLift_restricted (u : Adeles F) : d.IsRestrictedCover (d.upperLift u) :=
  (eventually_integral_component u).mono fun p hu =>
    Subgroup.subset_closure ⟨_,hu,Or.inl (d.upperLift_isUpper u (.inr p))⟩

def coverAction (g : ∀ v, d.cover v) (hg : d.IsRestrictedCover g) : d.Schwartz →ₗ[ℂ] d.Schwartz :=
  tensorMap d.basic d.basic (fun v => (g v).val.toLinearMap) (d.restrictedCover_fixes_basic hg)

theorem coverAction_pure (g : ∀ v, d.cover v) (hg : d.IsRestrictedCover g) (f : ∀ v, d.schwartz v)
    (hf : ∀ᶠ v in cofinite, f v = d.basic v) :
    d.coverAction g hg (d.pure f hf) =
      d.pure (fun v => (g v).val (f v)) ((hf.and (d.restrictedCover_fixes_basic hg)).mono (fun _ hi => hi.1 ▸ hi.2)) := by
  apply Subtype.ext
  change PiTensorProduct.map _ (PiTensorProduct.tprod ℂ f) = _
  rw [PiTensorProduct.map_tprod]
  rfl


/-- Restricted families of local lifts commute with the adelic Fourier transform. -/
theorem coverAction_fourier (g : ∀ v, d.cover v) (hg : d.IsRestrictedCover g) (Φ : d.Schwartz) :
    d.adelicFourier (d.coverAction g hg Φ) = d.coverAction g hg (d.adelicFourier Φ) := by
  let G (v : Place F) := (g v).val.toLinearMap
  have eqn : (fun v => (d.fourier v).comp (G v)) = fun v => (G v).comp (d.fourier v) := by
    funext v
    exact LinearMap.ext (d.fourier_equivariant v (g v))
  apply Subtype.ext
  change ((PiTensorProduct.map d.fourier).comp (PiTensorProduct.map G)) Φ.val =
    ((PiTensorProduct.map G).comp (PiTensorProduct.map d.fourier)) Φ.val
  rw [← PiTensorProduct.map_comp,← PiTensorProduct.map_comp,eqn]

def LiftsRationalMatrix (γ : SL(2,F)) (g : ∀ v, d.cover v) : Prop :=
  ∀ v, d.coverProjection v (g v) = Matrix.SpecialLinearGroup.map (diagonal F v) γ

private def hasRationalLift (γ : SL(2,F)) : Prop := ∃ g : ∀ v, d.cover v,
  d.IsRestrictedCover g ∧ d.LiftsRationalMatrix γ g ∧
  ∀ (f : ∀ v, d.schwartz v) (hf : ∀ᶠ v in cofinite, f v = d.basic v)
    (hgf : ∀ᶠ v in cofinite, (g v).val (f v) = d.basic v) (z : RationalPoint F),
      d.evaluation (d.pure (fun v => (g v).val (f v)) hgf) z = d.evaluation (d.pure f hf) (rationalRowPerm γ z)

private theorem hasRationalLift_mul (A B : SL(2,F)) (hA : d.hasRationalLift A) (hB : d.hasRationalLift B) :
    d.hasRationalLift (A*B) := by
  obtain ⟨g,hg,pg,eg⟩ := hA
  obtain ⟨s,hs,ps,es⟩ := hB
  refine ⟨fun v => g v * s v,?_,?_,?_⟩
  · exact (hg.and hs).mono fun p h => (d.integralCover p).mul_mem h.1 h.2
  · intro v
    rw [map_mul,pg,ps,map_mul]
  · intro f hf hgf z
    have hsf : ∀ᶠ v in cofinite, (s v).val (f v) = d.basic v :=
      (hf.and (d.restrictedCover_fixes_basic hs)).mono fun _ h => h.1 ▸ h.2
    rw [rationalRowPerm_mul]
    exact (eg _ hsf hgf z).trans (es f hf hsf _)

private theorem hasRationalLift_upper (t : F) :
    d.hasRationalLift (Matrix.SpecialLinearGroup.transvection (show (0 : Fin 2) ≠ 1 from zero_ne_one) t) := by
  choose s hs _ using fun v => d.exists_upper v (diagonal F v t)
  let g (v : Place F) : d.cover v := ⟨s v,Subgroup.subset_closure (Or.inr (Or.inl ⟨diagonal F v t,hs v⟩))⟩
  refine ⟨g,?_,?_,?_⟩
  · filter_upwards [eventually_diagonal_integral t] with p hp
    exact Subgroup.subset_closure ⟨_,hp,Or.inl (hs (.inr p))⟩
  · intro v
    apply Subtype.ext
    rw [show (d.coverProjection v (g v)).val = _ from (d.kubota_projection v).choose_spec.2.2.1 _ _ (hs v)]
    change !![1,diagonal F v t;0,1] = (Matrix.SpecialLinearGroup.transvection (show (0 : Fin 2) ≠ 1 from zero_ne_one) t).val.map (diagonal F v)
    rw [upperTransvection_matrix]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  · intro f hf hgf z
    apply d.rational_upper_evaluation t s hs f hf hgf
    rw [rationalRowPerm_val]
    simp [upperTransvection_matrix,mul_comm,add_comm]
private theorem hasRationalLift_lower (t : F) :
    d.hasRationalLift (Matrix.SpecialLinearGroup.transvection (show (1 : Fin 2) ≠ 0 from one_ne_zero) t) := by
  choose s hs _ using fun v => d.exists_lower v (diagonal F v t)
  let g (v : Place F) : d.cover v := ⟨s v,Subgroup.subset_closure (Or.inr (Or.inr ⟨diagonal F v t,hs v⟩))⟩
  refine ⟨g,?_,?_,?_⟩
  · filter_upwards [eventually_diagonal_integral t] with p hp
    exact Subgroup.subset_closure ⟨_,hp,Or.inr (hs (.inr p))⟩
  · intro v
    apply Subtype.ext
    rw [show (d.coverProjection v (g v)).val = _ from (d.kubota_projection v).choose_spec.2.2.2 _ _ (hs v)]
    change !![1,0;diagonal F v t,1] = (Matrix.SpecialLinearGroup.transvection (show (1 : Fin 2) ≠ 0 from one_ne_zero) t).val.map (diagonal F v)
    rw [lowerTransvection_matrix]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  · intro f hf hgf z
    apply d.rational_lower_evaluation t s hs f hf hgf
    rw [rationalRowPerm_val]
    simp [lowerTransvection_matrix,mul_comm]


/-- Lemma B.5. One restricted lift works for all adelic Schwartz sections
and all nonzero rational vectors. -/
theorem exists_rational_lift (γ : SL(2,F)) :
    ∃ (g : ∀ v, d.cover v) (hg : d.IsRestrictedCover g), d.LiftsRationalMatrix γ g ∧
      (∀ (Φ : d.Schwartz) z, d.evaluation (d.coverAction g hg Φ) z = d.evaluation Φ (rationalRowPerm γ z)) ∧
      ∀ Φ, d.theta (d.coverAction g hg Φ) = d.theta Φ := by
  have gen (i j : Fin 2) (h : i ≠ j) (c : F) : d.hasRationalLift (Matrix.SpecialLinearGroup.transvection h c) := by
    fin_cases i <;> fin_cases j
    · exact (h rfl).elim
    · exact d.hasRationalLift_upper c
    · exact d.hasRationalLift_lower c
    · exact (h rfl).elim
  obtain ⟨g,hg,hπ,e⟩ := Matrix.SL2.transvection_induction (d.hasRationalLift) gen d.hasRationalLift_mul γ
  have act (Φ : d.Schwartz) (z : RationalPoint F) :
      d.evaluation (d.coverAction g hg Φ) z = d.evaluation Φ (rationalRowPerm γ z) := by
    let ev (p : RationalPoint F) := (LinearMap.proj p).comp d.evaluation
    have eqn : (ev z).comp (d.coverAction g hg) = ev (rationalRowPerm γ z) := by
      apply d.ext_pure
      intro f hf
      change d.evaluation (d.coverAction g hg (d.pure f hf)) z = _
      rw [d.coverAction_pure]
      exact e f hf _ z
    exact LinearMap.congr_fun eqn Φ
  exact ⟨g,hg,hπ,act,fun Φ => (tsum_congr (act Φ)).trans ((rationalRowPerm γ).tsum_eq (d.evaluation Φ))⟩

/-- The theta expansion at the vertical vector, using one rational lift for each
coset representative as in the unfolding of Proposition B.6. -/
theorem exists_theta_coset_lifts :
    let Q := Quotient (QuotientGroup.rightRel (upperUnipotent F))
    ∃ (g : Q → ∀ v, d.cover v) (hg : ∀ q, d.IsRestrictedCover (g q)),
      (∀ q, d.LiftsRationalMatrix q.out (g q)) ∧ ∀ Φ : d.Schwartz,
        let f := fun q => d.evaluation (d.coverAction (g q) (hg q) Φ) (verticalPoint F)
        Summable (fun q => ‖f q‖) ∧ d.theta Φ = ∑' q, f q := by
  let Q := Quotient (QuotientGroup.rightRel (upperUnipotent F))
  choose g hg hp he _ using fun q : Q => d.exists_rational_lift q.out
  refine ⟨g,hg,hp,fun Φ => ?_⟩
  have eval (q : Q) : d.evaluation (d.coverAction (g q) (hg q) Φ) (verticalPoint F) =
      d.evaluation Φ (rationalBottomRowEquiv q) := by
    rw [he]
    apply congrArg (d.evaluation Φ)
    exact congrArg rationalBottomRowEquiv (Quotient.out_eq q)
  simpa only [eval] using d.theta_coset_expansion Φ

end Datum
end MetaplecticPoisson
