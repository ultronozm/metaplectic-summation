import MetaplecticSummation.Cusp.ThetaGrowth

/-! Restricted lifts of adelic matrices and the scalar relating two lifts. -/
noncomputable section
namespace MetaplecticPoisson.Datum
open NumberField Filter Set
open scoped Matrix MatrixGroups
open Classical
variable {F : Type} [Field F] [NumberField F] {n : ℕ} [NeZero n] (d : Datum F n)

private theorem weyl_product {K : Type} [Field K] (a : Kˣ) :
    !![1,a.val;0,1] * !![1,0;-a⁻¹.val,1] * !![1,a.val;0,1] = !![0,a.val;-a⁻¹.val,0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply,Fin.sum_univ_two,neg_mul,mul_neg,a.ne_zero]

/-- Every integral matrix at a finite place admits a lift generated by integral shears. -/
theorem exists_integral_lift (p : Prime F) (m : SL(2,LocalField F (.inr p)))
    (hint : ∀ i j, ‖m.val i j‖ ≤ 1) :
    ∃ g ∈ d.integralCover p, d.coverProjection (.inr p) g = m := by
  let K := LocalField F (.inr p)
  let : IsUltrametricDist K := inferInstanceAs (IsUltrametricDist (p.adicCompletion F))
  let H := (d.integralCover p).map (d.coverProjection (.inr p))
  let U (t : K) := upperUnipotentParam (Multiplicative.ofAdd t)
  let L (t : K) := Matrix.SpecialLinearGroup.transvection (show (1 : Fin 2) ≠ 0 from one_ne_zero) t
  have up (t : K) (ht : ‖t‖ ≤ 1) : U t ∈ H := by
    obtain ⟨s,hs,_⟩ := d.exists_upper (.inr p) t
    let g : d.cover (.inr p) := ⟨s,Subgroup.subset_closure (Or.inr (Or.inl ⟨t,hs⟩))⟩
    exact ⟨g,Subgroup.subset_closure ⟨t,ht,Or.inl hs⟩,Subtype.ext
      (((d.kubota_projection _).choose_spec.2.2.1 g t hs).trans (upperTransvection_matrix t).symm)⟩
  have low (t : K) (ht : ‖t‖ ≤ 1) : L t ∈ H := by
    obtain ⟨s,hs,_⟩ := d.exists_lower (.inr p) t
    let g : d.cover (.inr p) := ⟨s,Subgroup.subset_closure (Or.inr (Or.inr ⟨t,hs⟩))⟩
    exact ⟨g,Subgroup.subset_closure ⟨t,ht,Or.inr hs⟩,Subtype.ext
      (((d.kubota_projection _).choose_spec.2.2.2 g t hs).trans (lowerTransvection_matrix t).symm)⟩
  let W (a : Kˣ) := U a.val * L (-a⁻¹.val) * U a.val
  have form (a : Kˣ) : (W a).val = !![0,a.val;-a⁻¹.val,0] := by
    change (U a.val).val * (L (-a⁻¹.val)).val * (U a.val).val = _
    rw [show (U a.val).val = _ from upperTransvection_matrix _, show (L (-a⁻¹.val)).val = _ from lowerTransvection_matrix _]
    exact weyl_product a
  have weyl (a : Kˣ) (ha : ‖a.val‖ = 1) : W a ∈ H :=
    H.mul_mem (H.mul_mem (up _ ha.le) (low _ (by simp [Units.val_inv_eq_inv_val,ha]))) (up _ ha.le)
  have hw := weyl (-1) (by simp)
  obtain ⟨u,a,b,r,hu,ha,hr,he⟩ := exists_integral_local_iwasawa m hint
  change m ∈ H
  rw [he]
  refine H.mul_mem (H.mul_mem (up u hu) ?_) ?_
  · have e : diagonalSL a = W a * W (-1) := by
      apply Subtype.ext
      change (diagonalSL a).val = (W a).val * (W (-1)).val
      rw [diagonalSL_matrix,form,form]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply,Fin.sum_univ_two]
      exact (neg_neg _).symm
    exact e ▸ H.mul_mem (weyl a ha) hw
  · cases b with
    | false => exact (show iwasawaChart false r = L r from Subtype.ext (lowerTransvection_matrix r).symm) ▸ low r hr
    | true =>
      have e : iwasawaChart true r = W (-1) * U r := by
        apply Subtype.ext
        change !![0,-1;1,r] = (W (-1)).val * (U r).val
        rw [form,show (U r).val = _ from upperTransvection_matrix _]
        ext i j
        fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply,Fin.sum_univ_two]
      exact e ▸ H.mul_mem hw (up _ hr)

/-- The restricted cover surjects onto adelic SL₂. -/
theorem exists_restricted_lift (m : AdelicSL F) :
    ∃ g : ∀ v, d.cover v, d.IsRestrictedCover g ∧ d.LiftsAdelicMatrix m g := by
  let mᵥ := fun v => localMatrix F v m
  let integral := fun p : Prime F => ∀ i j, ‖(mᵥ (.inr p)).val i j‖ ≤ 1
  have hi : ∀ᶠ p in cofinite, integral p :=
    eventually_all.mpr fun i => eventually_all.mpr fun j =>
      (m.val i j).2.property.mono fun p hp => (mem_localIntegers_iff p _).mp hp
  let lift (v : Place F) := (d.kubota_projection v).choose_spec.1 (mᵥ v)
  let g (v : Place F) : d.cover v := match v with
    | .inl w => (lift (.inl w)).choose
    | .inr p => if h : integral p then (d.exists_integral_lift p _ h).choose else (lift (.inr p)).choose
  refine ⟨g,hi.mono (fun p hp => ?_),?_⟩
  · simpa only [g,dite_eq_left hp] using (d.exists_integral_lift p _ hp).choose_spec.1
  · rintro (w|p)
    · exact (lift (.inl w)).choose_spec
    · by_cases h : integral p
      · simpa only [g,dite_eq_left h] using (d.exists_integral_lift p _ h).choose_spec.2
      · simp only [g,dite_eq_right h]
        exact (lift (.inr p)).choose_spec

theorem IsRestrictedCover.mul {g h : ∀ v, d.cover v} (hg : d.IsRestrictedCover g) (hh : d.IsRestrictedCover h) :
    d.IsRestrictedCover (fun v => g v * h v) :=
  (hg.and hh).mono fun p e => (d.integralCover p).mul_mem e.1 e.2

theorem coverAction_mul (g h : ∀ v, d.cover v) (hg : d.IsRestrictedCover g) (hh : d.IsRestrictedCover h) (Φ : d.Schwartz) :
    d.coverAction (fun v => g v * h v) (hg.mul d hh) Φ = d.coverAction g hg (d.coverAction h hh Φ) := by
  apply Subtype.ext
  change PiTensorProduct.map _ Φ.val = PiTensorProduct.map _ (PiTensorProduct.map _ Φ.val)
  exact LinearMap.congr_fun (PiTensorProduct.map_comp (fun v => (g v).val.toLinearMap) (fun v => (h v).val.toLinearMap)) Φ.val

/-- Two restricted lifts of a matrix act on the entire adelic space by the same
operator up to a single scalar of absolute value one. -/
theorem coverAction_scalar_of_same_projection {m : AdelicSL F} {g h : ∀ v, d.cover v}
    (hg : d.IsRestrictedCover g) (hh : d.IsRestrictedCover h)
    (pg : d.LiftsAdelicMatrix m g) (ph : d.LiftsAdelicMatrix m h) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ Φ, d.coverAction g hg Φ = c • d.coverAction h hh Φ := by
  have diff (v : Place F) := ((d.kubota_projection v).choose_spec.2.1 (g v * (h v)⁻¹)).mp (by
    change d.coverProjection v (g v * (h v)⁻¹) = 1
    rw [map_mul,map_inv,pg,ph,mul_inv_cancel])
  choose z hz using diff
  let c := fun v => ((d.embedding (z v) : ℂˣ) : ℂ)
  have equal (v) (f : d.schwartz v) : (g v).val f = c v • (h v).val f := by
    have e := hz v ((h v).val f)
    change (g v).val ((h v).val.symm ((h v).val f)) = _ at e
    simpa only [LinearEquiv.symm_apply_apply] using e
  have cnorm (v) : ‖c v‖ = 1 := by
    apply Complex.norm_eq_one_of_pow_eq_one (n := n) _ (NeZero.ne n)
    change ((d.embedding (z v))^n).val = 1
    rw [← map_pow,show z v ^ n = 1 from Subtype.ext (z v).property,map_one,Units.val_one]
  let p := verticalPoint F
  have hc : ∀ᶠ v in cofinite, c v = 1 := by
    filter_upwards [d.restrictedCover_fixes_basic hg,d.restrictedCover_fixes_basic hh,d.eventually_basic_value p] with v eg eh ep
    have e := equal v (d.basic v)
    rw [eg,eh] at e
    have ev (a : ℂ) (φ : d.schwartz v) : d.localValue p v (a • φ) = a * d.localValue p v φ := by
      simp only [localValue,xChart,yChart]
      split <;> split <;> first | rfl | simp
    have e' := congrArg (d.localValue p v) e
    simpa only [ev,ep,mul_one] using e'.symm
  let s := (eventually_cofinite.mp hc).toFinset
  refine ⟨∏ v ∈ s, c v,by simp [norm_prod,cnorm],fun Φ => ?_⟩
  let G := fun v => (g v).val.toLinearMap
  let H := fun v => (h v).val.toLinearMap
  suffices eqn : PiTensorProduct.map G = (∏ v ∈ s, c v) • PiTensorProduct.map H by
    exact Subtype.ext (LinearMap.congr_fun eqn Φ.val)
  apply PiTensorProduct.ext
  apply MultilinearMap.ext
  intro f
  change PiTensorProduct.map G (PiTensorProduct.tprod ℂ f) = (∏ v ∈ s, c v) • PiTensorProduct.map H (PiTensorProduct.tprod ℂ f)
  rw [PiTensorProduct.map_tprod,PiTensorProduct.map_tprod,← (PiTensorProduct.tprod ℂ).map_piecewise_smul c _ s]
  apply congrArg (PiTensorProduct.tprod ℂ)
  funext v
  by_cases hv : v ∈ s
  · rw [Finset.piecewise_eq_of_mem _ _ _ hv]
    exact equal v _
  · have hcv : c v = 1 := by simpa [s] using hv
    rw [Finset.piecewise_eq_of_notMem _ _ _ hv]
    change (g v).val (f v) = (h v).val (f v)
    simpa only [hcv,one_smul] using equal v (f v)

end MetaplecticPoisson.Datum
