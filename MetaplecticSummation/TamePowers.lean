import MetaplecticSummation.HilbertTame
import MetaplecticSummation.TameSymbols
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots

/-! Nondegeneracy of the Hilbert pairing on power classes at tame finite places. -/

noncomputable section
namespace MetaplecticPoisson.Datum
open NumberField IsDedekindDomain IsLocalRing
open Classical
variable {F : Type} [Field F] [NumberField F] {n : ℕ} [NeZero n] (d : Datum F n)
variable (p : HeightOneSpectrum (𝓞 F))
local notation "K" => p.adicCompletion F
local notation "O" => p.adicCompletionIntegers F
local notation "k" => ResidueField O
local notation "N" => p.asIdeal.absNorm - 1
private abbrev residueUnits : Oˣ →* kˣ := Units.map (IsLocalRing.residue O).toMonoidHom
private abbrev includeUnits : Oˣ →* Kˣ := Units.map (p.adicCompletionIntegers F).subtype.toMonoidHom
local notation "red" => residueUnits p
local notation "inc" => includeUnits p

include d in
theorem tame_degree_dvd (hp : p.asIdeal.absNorm.Coprime n) : n ∣ p.asIdeal.absNorm - 1 := by
  obtain ⟨z,_,hr⟩ := tame_primitive_lift p d.primitive hp
  letI : Fintype k := Fintype.ofFinite k
  have hcard : Fintype.card k = p.asIdeal.absNorm := by
    rw [← Nat.card_eq_fintype_card,FinitePlace.natCard_residueField_adicCompletionIntegers]
  rw [← hcard]
  exact hr.dvd_of_pow_eq_one _ (FiniteField.pow_card_sub_one_eq_one _ (hr.ne_zero (NeZero.ne n)))

include d in
theorem tame_root_reduction_injective (hp : p.asIdeal.absNorm.Coprime n) {x y : O}
    (hx : x^n = 1) (hy : y^n = 1) (h : IsLocalRing.residue O x = IsLocalRing.residue O y) : x = y :=
  tame_root_reduction_injective_of_primitive p d.primitive hp hx hy h

private theorem units_lift (g : kˣ) : ∃ G : Oˣ, red G = g := by
  obtain ⟨x,hx⟩ := (IsLocalRing.residue_surjective (R := O)) g.val
  have hu := (residue_ne_zero_iff_isUnit x).mp (hx ▸ g.ne_zero)
  exact ⟨hu.unit,Units.ext (by simpa using hx)⟩

private theorem integral_unit_lift (a : Kˣ) (ha : ‖a.val‖ = 1) : ∃ A : Oˣ, inc A = a := by
  let x : O := ⟨a.val,(mem_localIntegers_iff p _).mpr ha.le⟩
  have hu := (localInteger_isUnit_iff p x).mpr ha
  exact ⟨hu.unit,Units.ext (congrArg Subtype.val hu.unit_spec)⟩

private theorem tame_unit_coordinates (hp : p.asIdeal.absNorm.Coprime n) (G : Oˣ)
    (hg : ∀ x, x ∈ Subgroup.zpowers (red G)) (U : Kˣ) (hU : ‖U.val‖ = 1) :
    ∃ (l : ℤ) (z : Kˣ), ‖z.val‖ = 1 ∧ U = (inc G)^l*z^n := by
  obtain ⟨A,hA⟩ := integral_unit_lift p U hU
  obtain ⟨l,hl⟩ := hg (red A)
  let B := A / G^l
  have hb : red B = 1 := by simp [B,map_div,map_zpow,hl]
  have hsub : ‖(inc B).val - 1‖ < 1 := by
    apply (residue_eq_iff_norm_sub_lt p B.val 1).mp
    simpa using congrArg Units.val hb
  obtain ⟨z,hz⟩ := FinitePlace.principal_unit_pow p hp (inc B) hsub
  have hB : ‖(inc B).val‖ = 1 := (localInteger_isUnit_iff p B.val).mp B.isUnit
  have hzn : ‖z.val‖ = 1 := by
    apply (pow_left_inj₀ (norm_nonneg _) zero_le_one (NeZero.ne n)).mp
    simpa only [← norm_pow,← Units.val_pow_eq_pow_val,hz,hB,one_pow]
  refine ⟨l,z,hzn,?_⟩
  rw [hz,show inc B = U / (inc G)^l by rw [show B = A/G^l from rfl,map_div,map_zpow,hA]]
  simp

/-- The tame local multiplicative group modulo n-th powers is generated by a
uniformizer and any lift of a residue-field generator. -/
private theorem tame_coordinates (hp : p.asIdeal.absNorm.Coprime n) (π : Kˣ)
    (hπ : ‖π.val‖ = (p.asIdeal.absNorm : ℝ)⁻¹) (G : Oˣ) (hg : ∀ x, x ∈ Subgroup.zpowers (red G)) (a : Kˣ) :
    ∃ (j l : ℤ) (z : Kˣ), a = π^j * (inc G)^l * z^n := by
  have hv := Valued.v.ne_zero_iff.mpr a.ne_zero
  let i := (Valued.v a.val).log
  have he : Valued.v a.val = WithZero.exp i := (WithZero.exp_log hv).symm
  have hnorm : ‖a.val‖ = (p.asIdeal.absNorm : ℝ)^i := by
    rw [NumberField.FinitePlace.norm_def,he,WithZeroMulInt.toNNReal_neg_apply _ (WithZero.exp_ne_zero (a := i))]
    change (↑((p.asIdeal.absNorm : NNReal)^i) : ℝ) = _
    simp
  let U := a / π^(-i)
  have hU : ‖U.val‖ = 1 := by
    have hpos : (p.asIdeal.absNorm : ℝ) ≠ 0 := by exact_mod_cast (Nat.zero_lt_one.trans (NumberField.HeightOneSpectrum.one_lt_absNorm p)).ne'
    simp [U,Units.val_zpow_eq_zpow_val,norm_zpow,hπ,hnorm]
    exact mul_inv_cancel₀ (zpow_ne_zero _ hpos)
  obtain ⟨l,z,_,hz⟩ := tame_unit_coordinates p hp G hg U hU
  refine ⟨-i,l,z,?_⟩
  rw [mul_assoc,← hz]
  simp [U]

/-- Tame normalization pairs a uniformizer and a residue generator to an
element of exact order n. Reduction detects that order. -/
private theorem tame_generator_order (hp : p.asIdeal.absNorm.Coprime n) (π : Kˣ)
    (hπ : ‖π.val‖ = (p.asIdeal.absNorm : ℝ)⁻¹) (G : Oˣ) (hg : ∀ x, x ∈ Subgroup.zpowers (red G)) :
    orderOf (d.unitPairing (.inr p) π (inc G)) = n := by
  have hgorder : orderOf (red G) = N := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg,Nat.card_units,FinitePlace.natCard_residueField_adicCompletionIntegers]
  have hg₀ : N ≠ 0 := Nat.sub_ne_zero_of_lt (NumberField.HeightOneSpectrum.one_lt_absNorm p)
  have hpoworder : orderOf ((red G)^(N/n)) = n := by
    rw [← hgorder]
    exact orderOf_pow_orderOf_div (hgorder ▸ hg₀) (hgorder ▸ d.tame_degree_dvd p hp)
  let family := (existsUnique_hilbert F n d.primitive).exists.choose
  have spec : IsHilbertFamily F n family := (existsUnique_hilbert F n d.primitive).exists.choose_spec
  let θ := family (.inr p) π (inc G)
  let δ := Units.map (diagonal F (.inr p)).toMonoidHom θ.val
  have hδ : δ.val^n = 1 := by
    change (diagonal F (.inr p) θ.val.val)^n = 1
    rw [← map_pow,show θ.val.val^n = 1 from congrArg Units.val θ.property,map_one]
  obtain ⟨A,hA⟩ := integral_unit_lift p δ (norm_one_of_power p hδ)
  have hG := (localInteger_isUnit_iff p G.val).mp G.isUnit
  have hred : red A = (red G)^(N/n) := by
    apply Units.ext
    change IsLocalRing.residue O A.val = (IsLocalRing.residue O G.val)^(N/n)
    rw [← map_pow,residue_eq_iff_norm_sub_lt]
    change ‖(inc A).val - (inc G).val^(N/n)‖ < 1
    rw [hA]
    exact spec.tame_uniformizer p hp π (inc G) hπ hG
  let m := orderOf (d.embedding θ)
  apply Nat.dvd_antisymm (orderOf_dvd_of_pow_eq_one (d.unitPairing_pow _ _ _))
  change n ∣ m
  rw [← hpoworder,← hred,orderOf_dvd_iff_pow_eq_one,← map_pow]
  suffices h : A^m = 1 by rw [h,map_one]
  have hd : θ^m = 1 := d.injective (by rw [map_pow,map_one]; exact pow_orderOf_eq_one _)
  have hv := congrArg (fun θ : Mu F n => Units.map (diagonal F (.inr p)).toMonoidHom θ.val) hd
  simp only [Subgroup.coe_pow,Subgroup.coe_one,map_pow,map_one] at hv
  apply (Units.map_injective (f := (p.adicCompletionIntegers F).subtype.toMonoidHom) Subtype.val_injective)
  rw [map_pow,map_one]
  change (inc A)^m = 1
  rwa [hA]

/-- A residue generator generates the units modulo n-th powers and its Hilbert
pairing with a uniformizer is a primitive n-th root. -/
theorem tame_unit_generator (hp : p.asIdeal.absNorm.Coprime n) (π : Kˣ)
    (hπ : ‖π.val‖ = (p.asIdeal.absNorm : ℝ)⁻¹) :
    ∃ U : Kˣ, ‖U.val‖ = 1 ∧ orderOf (d.unitPairing (.inr p) π U) = n ∧
      ∀ u : Kˣ, ‖u.val‖ = 1 → ∃ (l : ℤ) (z : Kˣ), ‖z.val‖ = 1 ∧ u = U^l*z^n := by
  obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := kˣ)
  obtain ⟨G,hG⟩ := units_lift p g
  have gen : ∀ x, x ∈ Subgroup.zpowers (red G) := hG ▸ hg
  exact ⟨inc G,(localInteger_isUnit_iff p G.val).mp G.isUnit,d.tame_generator_order p hp π hπ G gen,
    tame_unit_coordinates p hp G gen⟩

/-- At a tame place, the Hilbert character of an element is trivial on
the unit group only if its valuation is divisible by the cover degree. -/
theorem norm_power_of_trivial_on_units (hp : p.asIdeal.absNorm.Coprime n) (a : Kˣ)
    (ha : ∀ u : Kˣ, ‖u.val‖ = 1 → d.symbol (.inr p) a u = 1) :
    ∃ t : Kˣ, ‖a.val‖ = ‖t.val‖^n := by
  let H : Kˣ →* Kˣ →* ℂˣ := d.unitPairing (.inr p)
  obtain ⟨π,hπ⟩ := FinitePlace.exists_norm_uniformizer p
  obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := kˣ)
  obtain ⟨G,hG⟩ := units_lift p g
  let U := inc G
  have hu : ‖U.val‖ = 1 := (localInteger_isUnit_iff p G.val).mp G.isUnit
  have hgen : orderOf (H π U) = n := d.tame_generator_order p hp π hπ G (by simpa only [hG] using hg)
  obtain ⟨j,l,z,he⟩ := tame_coordinates p hp π hπ G (by simpa only [hG] using hg) a
  have h : H a U = 1 := Units.ext (ha U hu)
  have huu : H U U = 1 := d.unitPairing_tame_units p hp U U hu hu
  have hz : H z U ^ n = 1 := d.unitPairing_pow _ _ _
  rw [he] at h
  change H (π^j*U^l*z^n) U = 1 at h
  simp only [map_mul,map_zpow,map_pow,MonoidHom.mul_apply,MonoidHom.zpow_apply,
    MonoidHom.pow_apply,huu,hz,one_zpow,mul_one] at h
  obtain ⟨i,hi⟩ := (show (n : ℤ) ∣ j by rwa [← hgen,orderOf_dvd_iff_zpow_eq_one])
  refine ⟨π^i*z,?_⟩
  rw [he,hi]
  change ‖(π^((n:ℤ)*i)*U^l*z^n).val‖ = ‖(π^i*z).val‖^n
  rw [Int.mul_comm (n : ℤ),zpow_mul,zpow_natCast]
  simp only [Units.val_mul,Units.val_zpow_eq_zpow_val,Units.val_pow_eq_pow_val,norm_mul,norm_pow,
    norm_zpow,hu,one_zpow,mul_one,mul_pow]

/-- Property 2(b) of the Hilbert symbol at every tame finite place. -/
theorem tame_symbol_radical (hp : p.asIdeal.absNorm.Coprime n) (a : Kˣ) :
    (∀ x : Kˣ, d.symbol (.inr p) x a = 1) ↔ ∃ z : Kˣ, z^n = a := by
  let v : Place F := .inr p
  let H : Kˣ →* Kˣ →* ℂˣ := d.unitPairing v
  have htor (x y : Kˣ) : (H x y)^n = 1 := d.unitPairing_pow v x y
  constructor
  · intro hr
    obtain ⟨π,hπ⟩ := FinitePlace.exists_norm_uniformizer p
    obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := kˣ)
    obtain ⟨G,hG⟩ := units_lift p g
    let U := inc G
    have hgen : orderOf (H π U) = n := d.tame_generator_order p hp π hπ G (by simpa only [hG] using hg)
    obtain ⟨j,l,z,ha⟩ := tame_coordinates p hp π hπ G (by simpa only [hG] using hg) a
    have hu : ‖U.val‖ = 1 := (localInteger_isUnit_iff p G.val).mp G.isUnit
    have huu : H U U = 1 := d.unitPairing_tame_units p hp U U hu hu
    have ht (x : Kˣ) : (H x π)^j * (H x U)^l = 1 := by
      have hr' : H x a = 1 := Units.ext (hr x)
      rw [ha,map_mul,map_mul,map_zpow,map_zpow,map_pow,htor,mul_one] at hr'
      exact hr'
    have hj : (n : ℤ) ∣ j := by
      rw [← hgen,orderOf_dvd_iff_zpow_eq_one]
      have h := ht U
      rw [huu,one_zpow,mul_one] at h
      have hs : H π U = (H U π)⁻¹ := (d.lineSymbol v (d.tame_steinberg p hp)).skew π U
      rw [hs,inv_zpow,h,inv_one]
    obtain ⟨i,rfl⟩ := hj
    have hl : (n : ℤ) ∣ l := by
      rw [← hgen,orderOf_dvd_iff_zpow_eq_one]
      have h := ht π
      rwa [zpow_mul,zpow_natCast,htor,one_zpow,one_mul] at h
    obtain ⟨j,rfl⟩ := hl
    refine ⟨π^i * U^j * z,?_⟩
    rw [ha,mul_pow,mul_pow]
    simp only [← zpow_natCast,← zpow_mul,Int.mul_comm i,Int.mul_comm j,U]
  · rintro ⟨z,rfl⟩ x
    change (H x (z^n)).val = 1
    rw [map_pow,htor,Units.val_one]

end MetaplecticPoisson.Datum
