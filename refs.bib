@article{2021arXiv2107.01874,
  title                    = {{Schubert} {Eisenstein} series and {Poisson} summation for {Schubert} varieties},
  author                   = {YoungJu Choie and Jayce R. Getz},
  journal                  = {Amer. J. Math.},
  year                     = {2025},
  volume                   = {147},
  number                   = {3},
  pages                    = {597--653},
  doi                      = {10.1353/ajm.2025.a961343},
  eprint                   = {2107.01874},
  eprinttype               = {arXiv},
  abstract                 = { The first author and Bump defined Schubert Eisenstein series by restricting
the summation in a degenerate Eisenstein series to a particular Schubert
variety. In the case of $\mathrm{GL}_3$ over $\mathbb{Q}$ they proved that
these Schubert Eisenstein series have meromorphic continuations in all
parameters and conjectured the same is true in general. We revisit their
conjecture and relate it to the program of Braverman, Kazhdan, Lafforgue,
Ng\^o, and Sakellaridis aimed at establishing generalizations of the Poisson
summation formula. We prove the Poisson summation formula for certain schemes
closely related to Schubert varieties and use it to refine and establish the
conjecture of the first author and Bump in many cases.},
  display-string = {(2025) YoungJu Choie and Jayce R. Getz - Schubert Eisenstein series and Poisson summation for Schubert varieties}
}

@misc{2023arXiv2306.11875,
  display-string = {(2023) Chantal David and Alexander Dunn and Alia Hamieh and Hua Lin - Quartic Gauss sums over primes and metaplectic theta functions},
  title                    = {Quartic {Gauss} sums over primes and metaplectic theta functions},
  author                   = {Chantal David and Alexander Dunn and Alia Hamieh and Hua Lin},
  year                     = {2023},
  month                    = {06},
  url                      = {https://arxiv.org/abs/2306.11875},
  note                     = {arXiv:2306.11875},
  eprinttype               = {arXiv},
  abstract                 = {We improve 1987 estimates of Patterson for sums of quartic Gauss sums over primes. Our Type-I and Type-II estimates feature new ideas, including use of the quadratic large sieve over $\mathbb{Q}(i)$, and Suzuki's evaluation of the Fourier-Whittaker coefficients of quartic theta functions at squares. We also conjecture asymptotics for certain moments of quartic Gauss sums over primes.}
}

@misc{2025arXiv2507.08662,
  display-string = {(2025) Will Sawin and Ian Whitehead - Functional equations of axiomatic multiple Dirichlet series, Weyl groupoids, and quantum algebra},
  title                    = {Functional equations of axiomatic multiple {Dirichlet} series, {Weyl} groupoids, and quantum algebra},
  author                   = {Will Sawin and Ian Whitehead},
  year                     = {2025},
  month                    = jul,
  url                      = {http://arxiv.org/abs/2507.08662v2},
  note                     = {arXiv:2507.08662},
  eprinttype               = {arXiv},
  abstract                 = {We prove functional equations for multiple Dirichlet series defined by a collection of five geometric axioms. We find functional equations of two types: one modeled on the functional equations of Dirichlet $L$-functions, and another modeled on the functional equations of Kubota $L$-series with Gauss sums as coefficients. These functional equations generate groupoid structures, which we relate to the Weyl groupoids of arithmetic root systems. From the known classification of arithmetic root systems, we obtain a complete classification of multiple Dirichlet series which can be used to compute moments of $L$-functions via established analytic techniques. Our classification includes all moments of $L$-functions which have appeared in the multiple Dirichlet series literature previously, alongside some new moments. Finally, we give applications of our functional equations to quantum algebra, specifically the cohomology of Nichols algebras.}
}

@misc{2026arXiv2611.16665,
  display-string = {(2026) Xin Hang Ji - Proof of the Quasi Riemann Hypothesis using $\mathbb Q[i]$},
  title                    = {Proof of the Quasi {Riemann} Hypothesis using {$\mathbb{Q}[i]$}},
  author                   = {Xin Hang Ji},
  year                     = {2026},
  month                    = {11},
  url                      = {http://arxiv.org/abs/2611.16665v1},
  note                     = {arXiv:2611.16665},
  eprinttype               = {arXiv},
  abstract                 = {Using quartic Gauss sums in place of the cubic Gauss sums in OpenAI's original proof, we prove that the Dedekind $ζ$-function $ζ_{\mathbb Q(i)}(s)$ of $\mathbb Q(i)$ has no zeros in the half-plane $\Re s>599/600$, thereby obtaining the same zero-free half-plane for the Riemann $ζ$-function.We obtain the upper bound for the smoothed sum by applying Poisson summation twice and using the functional equation of the quartic Kubota series of angular weight $1$.In the Mellin representation, a zero-density bound for the family of quartic characters controls the terms from nonprincipal characters,and a residue and a lattice average over fourth powers give the main term.}
}

