/-! ## Bridge to the proof development

The development fixes the self-dual measures and the Hilbert symbols by choice
from proved existence and uniqueness statements. Any measures and symbols with
the defining properties are those choices; after substituting them, the
definitions above agree definitionally with the development's, and its
theorems apply. -/

set_option linter.unusedSectionVars false
set_option maxHeartbeats 2000000

namespace Bridge

theorem isHilbert {m : ℕ} {H : SymbolFamily F m} (h : IsHilbertFamily F m H) :
    MetaplecticPoisson.IsHilbertFamily F m H :=
  ⟨h.continuous_pair, h.mul_left, h.mul_right, h.skew, h.neg_self, h.tame_units,
    h.tame_uniformizer, h.unramified, h.reciprocity⟩

theorem measure_eq (ψ : MetaplecticPoisson.Character F) {μ : ∀ v, Measure (LocalField F v)}
    (hμ : ∀ v, IsSelfDual ψ.toChar v (μ v)) :
    μ = fun v => MetaplecticPoisson.selfDual F ψ v :=
  funext fun v => (MetaplecticPoisson.existsUnique_selfDual F ψ v).unique (hμ v)
    (MetaplecticPoisson.existsUnique_selfDual F ψ v).exists.choose_spec

theorem hilbert_eq {m : ℕ} [NeZero m] {ζ : F} (hζ : IsPrimitiveRoot ζ m) {H : SymbolFamily F m}
    (hH : IsHilbertFamily F m H) :
    H = (MetaplecticPoisson.existsUnique_hilbert F m hζ).exists.choose :=
  (MetaplecticPoisson.existsUnique_hilbert F m hζ).unique (isHilbert hH)
    (MetaplecticPoisson.existsUnique_hilbert F m hζ).exists.choose_spec

/-- The development's twist attached to a twist. -/
def toTwist {S : Finset (Place F)} {f : NonzeroInteger S} (T : Twist n S f) :
    MetaplecticPoisson.Datum.Twist (n := n) S f :=
  ⟨T.primes, T.outside, T.character, T.continuous_char, T.exponent, T.positive, T.conductor,
    T.generator, T.unit_elsewhere, T.empty_modulus⟩

/-- An injective homomorphism `μ₂ → ℂˣ` is unique. -/
theorem mu2_embedding_unique (e₁ e₂ : Mu F 2 →* ℂˣ)
    (h₁ : Function.Injective e₁) (h₂ : Function.Injective e₂) : e₁ = e₂ := by
  have key (e : Mu F 2 →* ℂˣ) (he : Function.Injective e) (z : Mu F 2) (hz : z ≠ 1) :
      ((e z : ℂˣ) : ℂ) = -1 := by
    have hsq : z ^ 2 = 1 := Subtype.ext ((mem_rootsOfUnity 2 (z : Fˣ)).mp z.property)
    have h1 : ((e z : ℂˣ) : ℂ) ^ 2 = 1 := by
      rw [← Units.val_pow_eq_pow_val, ← map_pow, hsq, map_one, Units.val_one]
    have hne : ((e z : ℂˣ) : ℂ) ≠ 1 := fun h =>
      hz (he ((Units.ext h).trans e.map_one.symm))
    exact (sq_eq_one_iff.mp h1).resolve_left hne
  ext z
  by_cases hz : z = 1
  · rw [hz, map_one, map_one]
  · rw [key e₁ h₁ z hz, key e₂ h₂ z hz]

/-- The classical setting in the development's form. -/
theorem classicalSetting (d : MetaplecticPoisson.Datum F n) {S : Finset (Place F)}
    (hS : ClassicalSetting n d.character.toChar S) : d.ClassicalSetting S := by
  refine ⟨⟨hS.nonempty, hS.infinite, fun p hp => ⟨hS.coprime p hp, fun x hx => ?_⟩⟩,
    hS.unramified, hS.principal⟩
  have h := ((hS.unramified p hp 1).mpr (by simp)) x hx
  exact (congrArg (MetaplecticPoisson.Character.localValue F d.character (.inr p))
    (one_mul x).symm).trans h

/-- The moments for `ψ(b ·)` are a fixed multiple of those for `ψ`. -/
theorem moment_scaled (d : MetaplecticPoisson.Datum F n) {S : Finset (Place F)} (b : Fˣ)
    (W : Weights S) (β : Classes n S) :
    (d.scaled b).moment W β =
      (∏ v : S, (NNReal.sqrt (modulus F v.val (diagonal F v.val b)).toNNReal : ℂ)) *
        d.moment W β := by
  simp only [MetaplecticPoisson.Datum.moment, MetaplecticPoisson.Datum.classMoment,
    MetaplecticPoisson.Datum.lineIntegral_scaled, Finset.prod_mul_distrib]
  rfl

end Bridge

-- proof: exists_selfDual_hilbert
  ⟨fun v => MetaplecticPoisson.selfDual F ⟨ψ, hψ, hnt, htriv⟩ v,
    (MetaplecticPoisson.existsUnique_hilbert F n hζ).exists.choose,
    fun v => (MetaplecticPoisson.existsUnique_selfDual F ⟨ψ, hψ, hnt, htriv⟩ v).exists.choose_spec,
    by
      let h := (MetaplecticPoisson.existsUnique_hilbert F n hζ).exists.choose_spec
      exact ⟨h.continuous_pair, h.mul_left, h.mul_right, h.skew, h.neg_self, h.tame_units,
        h.tame_uniformizer, h.unramified, h.reciprocity⟩⟩
-- proof: twistedGaussSummation
  by
  intro σ
  obtain rfl := Bridge.measure_eq ⟨ψ, hψ, hnt, htriv⟩ hμ
  obtain rfl := Bridge.hilbert_eq hζ hH
  let d : MetaplecticPoisson.Datum F n := ⟨ζ, hζ, ε, hε, ⟨ψ, hψ, hnt, htriv⟩⟩
  have h' : d.ClassicalSetting S := Bridge.classicalSetting d hS
  let ρ₀ := ((d.scaled (fieldUnit b)).lineSummation S (d.scaled_good h' b)).exists.choose
  let C : ℂ := ∏ v : S,
    (NNReal.sqrt (modulus F v.val (diagonal F v.val (fieldUnit b : F))).toNNReal : ℂ)
  refine ⟨fun β => (Real.sqrt (sNorm S (fieldUnit b)) : ℂ) * (ρ₀ β * C), ?_, ?_⟩
  swap
  · -- uniqueness: the empty twist and a test with a single nonzero moment
    classical
    intro ρ' hρ'
    funext α
    obtain ⟨W, hW, hM0⟩ := d.exists_moment_single α
    have hMα : d.moment W α = 1 := (hM0 α).trans (ite_eq_left rfl)
    have hMβ (β : Classes n S) (hβ : β ≠ α) : d.moment W β = 0 := by
      have h := hM0 β
      exact h.trans (ite_eq_right (by exact hβ))
    let one : NonzeroInteger S := ⟨1, one_ne_zero⟩
    have h1 : fieldUnit one = 1 := Units.ext rfl
    let T0 : Twist n S one :=
      { primes := ∅, outside := fun p hp => absurd hp (Finset.notMem_empty p),
        character := fun p => absurd p.2 (Finset.notMem_empty p.1),
        continuous_char := fun p => absurd p.2 (Finset.notMem_empty p.1),
        exponent := fun _ => 1, positive := fun _ => one_pos,
        conductor := fun p => absurd p.2 (Finset.notMem_empty p.1),
        generator := fun p => absurd p.2 (Finset.notMem_empty p.1),
        unit_elsewhere := fun p _ _ => by rw [h1, Units.val_one, map_one, norm_one],
        empty_modulus := fun _ => h1 }
    have hcop : IsCoprime b.val one.val := isCoprime_one_right
    have e1 := (hρ' one T0 hcop W hW).2.2.2
    obtain ⟨_, H⟩ := d.twistedGaussSummation h' one b (Bridge.toTwist T0) hcop W hW
    have e2 := H.symm.trans e1
    have hcard : (Bridge.toTwist T0).primes.card = 0 := rfl
    have hcard' : T0.primes.card = 0 := rfl
    change _ + (if (Bridge.toTwist T0).primes.card = 0 then d.mainTerm h' b W else 0) =
      _ + (if T0.primes.card = 0 then ∑ᶠ β, ρ' β * d.moment W β else 0) at e2
    simp only [hcard, hcard', ↓reduceIte] at e2
    have e3 := add_left_cancel e2
    have eval (a : Classes n S → ℂ) : ∑ᶠ β, a β * d.moment W β = a α := by
      rw [finsum_eq_single _ α (fun β hβ => by rw [hMβ β hβ, mul_zero]), hMα, mul_one]
    rw [eval] at e3
    rw [← e3]
    simp only [MetaplecticPoisson.Datum.mainTerm]
    have hs : (∑ᶠ β, ρ₀ β * (d.scaled (fieldUnit b)).moment W β) = ρ₀ α * C := by
      have : (fun β => ρ₀ β * (d.scaled (fieldUnit b)).moment W β) = fun β => (ρ₀ β * C) * d.moment W β := by
        funext β; rw [Bridge.moment_scaled d (fieldUnit b) W β]; ring
      rw [this]; exact eval (fun β => ρ₀ β * C)
    exact congrArg (_ * ·) hs
  intro f T hcop W hW
  obtain ⟨hε', H⟩ := d.twistedGaussSummation h' f b (Bridge.toTwist T) hcop W hW
  obtain ⟨hs₁, hs₂⟩ := d.summable_twistedGauss h' b (Bridge.toTwist T) hcop W hW
  refine ⟨hε', hs₁, hs₂, ?_⟩
  refine H.trans ?_
  congr 1
  change (if T.primes.card = 0 then d.mainTerm h' b W else 0) = _
  split_ifs
  · simp only [MetaplecticPoisson.Datum.mainTerm]
    rw [mul_finsum]
    apply finsum_congr
    intro β
    show (Real.sqrt (sNorm S (fieldUnit b : F)) : ℂ) *
        (ρ₀ β * (d.scaled (fieldUnit b)).moment W β) =
      (Real.sqrt (sNorm S (fieldUnit b : F)) : ℂ) * (ρ₀ β * C) * d.moment W β
    rw [Bridge.moment_scaled d (fieldUnit b) W β]
    ring
  · rfl
-- proof: quadraticDual
  by
  intro σ σ₂
  obtain rfl := Bridge.measure_eq ⟨ψ, hψ, hnt, htriv⟩ hμ
  obtain rfl := Bridge.hilbert_eq hζ hH
  let d : MetaplecticPoisson.Datum F n := ⟨ζ, hζ, ε, hε, ⟨ψ, hψ, hnt, htriv⟩⟩
  obtain rfl := Bridge.hilbert_eq d.quadraticDatum.primitive hH₂
  obtain rfl := Bridge.mu2_embedding_unique ε₂ d.quadraticDatum.embedding hε₂
    d.quadraticDatum.injective
  exact d.quadraticDual (Bridge.classicalSetting d hS) odd awayTwo h nonunit squarefree
